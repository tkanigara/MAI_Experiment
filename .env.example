# ASYNC REPORT GENERATION
# Local/Docker development: local. Cloud Run: cloud_tasks.
REPORT_QUEUE_BACKEND=local
REPORT_LOCAL_RETRY_DELAY_SECONDS=1
CLOUD_TASKS_PROJECT=
CLOUD_TASKS_LOCATION=asia-southeast2
CLOUD_TASKS_QUEUE=mai-report-generation-staging
REPORT_WORKER_BASE_URL=
REPORT_TASK_CALLER_SERVICE_ACCOUNT=
# Usually the same origin as REPORT_WORKER_BASE_URL, without a path.
REPORT_TASK_OIDC_AUDIENCE=
REPORT_TASK_DISPATCH_DEADLINE_SECONDS=900
REPORT_JOB_LEASE_SECONDS=900
# Run generation in an isolated process so a blocking Gemini/Google request
# can be terminated after cancellation.
REPORT_JOB_HARD_CANCEL=true
REPORT_CANCEL_POLL_SECONDS=1
REPORT_CANCEL_GRACE_SECONDS=2
REPORT_JOB_PROCESS_START_METHOD=spawn
